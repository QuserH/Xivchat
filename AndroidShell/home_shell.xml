<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@+id/home_shell" android:clickable="true" android:focusable="true" android:background="@drawable/home_shell_background"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingLeft="24dp" android:paddingTop="28dp" android:paddingRight="24dp" android:paddingBottom="24dp">
        <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="AETHERPHONE" android:textColor="#FFF4F1FF" android:textSize="12sp" android:letterSpacing="0.18" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:text="●  ONLINE" android:textColor="#FF8BE8C1" android:textSize="11sp" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:text="手机终端" android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="游戏数据与消息" android:textColor="#BFE8DFF2" android:textSize="14sp" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <GridLayout android:columnCount="3" android:rowCount="2" android:alignmentMode="alignMargins" android:useDefaultMargins="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="22dp">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:onClick="openXivchat" android:background="@drawable/home_app_tile" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:layout_rowWeight="1">
                <TextView android:text="✦" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="30sp" android:background="@drawable/home_app_icon" android:layout_width="58dp" android:layout_height="58dp" />
                <TextView android:text="XIVChat" android:textColor="#FFF4F1FF" android:textSize="13sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="游戏聊天" android:textColor="#99E8DFF2" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/home_app_tile_muted" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:layout_rowWeight="1">
                <TextView android:text="☷" android:gravity="center" android:textColor="#FFB9B1DB" android:textSize="28sp" android:background="@drawable/home_app_icon_muted" android:layout_width="58dp" android:layout_height="58dp" />
                <TextView android:text="好友" android:textColor="#FFE8DFF2" android:textSize="13sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="内置于 XIVChat" android:textColor="#99E8DFF2" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/home_app_tile_muted" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:layout_rowWeight="1">
                <TextView android:text="⌁" android:gravity="center" android:textColor="#FFB9B1DB" android:textSize="28sp" android:background="@drawable/home_app_icon_muted" android:layout_width="58dp" android:layout_height="58dp" />
                <TextView android:text="通知" android:textColor="#FFE8DFF2" android:textSize="13sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="即将加入" android:textColor="#99E8DFF2" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </GridLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/home_dock" android:paddingLeft="16dp" android:paddingTop="12dp" android:paddingRight="16dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="XIVChat 安全连接" android:textColor="#FFEFE9F8" android:textSize="12sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:text="14777  ·  加密" android:textColor="#FF9E91BD" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
